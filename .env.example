# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (proposal media library). Auto-set when the store is linked to the project; use `vercel env pull` locally.
BLOB_READ_WRITE_TOKEN=

# Optional: custom folder prefix for library blobs (must match on server and client if overridden).
# PROPOSAL_MEDIA_LIBRARY_PREFIX=proposal-media-library/
# NEXT_PUBLIC_PROPOSAL_MEDIA_LIBRARY_PREFIX=proposal-media-library/

# Firebase (client) — same project as your iOS app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — paste JSON from a service account with Firestore access
# Use double quotes and escape inner quotes, or load via GOOGLE_APPLICATION_CREDENTIALS locally
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional local path alternative to FIREBASE_SERVICE_ACCOUNT_JSON
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Explicit project id for Firebase Admin in local/serverless runtimes
FIREBASE_PROJECT_ID=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
