# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated extra browser origins for Firebase/GCS CORS (e.g. https://your-app-git-main.vercel.app).
# Must match the browser exactly: apex vs www, and Vercel preview hostnames (GCS has no *.vercel.app wildcard).
# Used by: npm run storage:cors:apply (see scripts/gcs-cors.mjs). Verify with: npm run storage:cors:show
GCS_CORS_EXTRA_ORIGINS=

# Firebase (client) — same project as your iOS app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — paste JSON from a service account with Firestore access
# Use double quotes and escape inner quotes, or load via GOOGLE_APPLICATION_CREDENTIALS locally
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional local path alternative to FIREBASE_SERVICE_ACCOUNT_JSON
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Explicit project id for Firebase Admin in local/serverless runtimes
FIREBASE_PROJECT_ID=

# Same bucket as NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET; used server-side and for storage:cors:apply
FIREBASE_STORAGE_BUCKET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
